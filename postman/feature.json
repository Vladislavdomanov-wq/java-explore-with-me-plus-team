{
  "info": {
    "_postman_id": "b7f5c3a2-4d1e-4b8f-9c6a-2e7d1f3a5b9c",
    "name": "ExploreWithMe Feature: Subscriptions",
    "description": "Тесты подписок на пользователя. Коллекция самодостаточна: сначала создаются два пользователя, затем выполняются проверки в заданном порядке.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Подготовка",
      "item": [
        {
          "name": "Создать пользователя-подписчика",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('subscriberEmail', 'subscriber-' + Date.now() + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Пользователь-подписчик создан', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const user = pm.response.json();",
                  "    pm.expect(user).to.have.property('id');",
                  "    pm.collectionVariables.set('subscriberId', user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Subscriber\",\n  \"email\": \"{{subscriberEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Создать пользователя-автора",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('authorEmail', 'author-' + Date.now() + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Пользователь-автор создан', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const user = pm.response.json();",
                  "    pm.expect(user).to.have.property('id');",
                  "    pm.collectionVariables.set('authorId', user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Author\",\n  \"email\": \"{{authorEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Подписки",
      "item": [
        {
          "name": "Подписка на пользователя — 201 Created",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Подписка создана: 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Ответ содержит данные подписки', function () {",
                  "    const subscription = pm.response.json();",
                  "    pm.expect(subscription).to.have.property('id');",
                  "    pm.expect(subscription).to.have.property('subscriberId');",
                  "    pm.expect(subscription).to.have.property('authorId');",
                  "    pm.expect(subscription).to.have.property('createdOn');",
                  "    pm.expect(String(subscription.subscriberId)).to.eql(String(pm.collectionVariables.get('subscriberId')));",
                  "    pm.expect(String(subscription.authorId)).to.eql(String(pm.collectionVariables.get('authorId')));",
                  "    pm.collectionVariables.set('subscriptionId', subscription.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{subscriberId}}/subscriptions/{{authorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{subscriberId}}",
                "subscriptions",
                "{{authorId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Подписка на себя — 400 Bad Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Нельзя подписаться на себя: 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Ошибка содержит статус BAD_REQUEST', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('BAD_REQUEST');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{subscriberId}}/subscriptions/{{subscriberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{subscriberId}}",
                "subscriptions",
                "{{subscriberId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Повторная подписка — 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Повторная подписка запрещена: 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Ошибка содержит статус CONFLICT', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('CONFLICT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{subscriberId}}/subscriptions/{{authorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{subscriberId}}",
                "subscriptions",
                "{{authorId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Получение списка подписок — 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Список подписок получен: 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('В списке есть подписка на автора', function () {",
                  "    const authorId = String(pm.collectionVariables.get('authorId'));",
                  "    const subscriptions = pm.response.json();",
                  "    const found = subscriptions.some(function (subscription) {",
                  "        return String(subscription.authorId) === authorId;",
                  "    });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{subscriberId}}/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{subscriberId}}",
                "subscriptions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Отписка — 204 No Content",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Отписка выполнена: 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('Тело ответа пустое', function () {",
                  "    pm.expect(pm.response.text()).to.eql('');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{subscriberId}}/subscriptions/{{authorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{subscriberId}}",
                "subscriptions",
                "{{authorId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Отписка без подписки — 404 Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Отписка без подписки: 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Ошибка содержит статус NOT_FOUND', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{subscriberId}}/subscriptions/{{authorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{subscriberId}}",
                "subscriptions",
                "{{authorId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "subscriberId",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "subscriberEmail",
